{
    "name": "ik-oss/mezzio-navigation",
    "description": "Page, middleware and factories for navigations in a mezzio application",
    "license": "MIT",
    "keywords": [
        "laminas",
        "mezzio",
        "mezzio-navigation"
    ],
    "require": {
        "php": "~8.5.0",
        "laminas/laminas-navigation": "^2.23",
        "laminas/laminas-stdlib": "^3.21",
        "mezzio/mezzio-helpers": "^5.20",
        "mezzio/mezzio-router": "^4.2",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-config": "^3.11",
        "laminas/laminas-diactoros": "^3.7",
        "laminas/laminas-servicemanager": "^3.24 || ^4.5",
        "mezzio/mezzio-laminasrouter": "^3.12",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "laminas/laminas-config": "^3.11, to provide page configuration (optional, as arrays and Traversables are also allowed)",
        "laminas/laminas-view": "^2.35, to use the navigation view helpers"
    },
    "autoload": {
        "psr-4": {
            "Ikoss\\Mezzio\\Navigation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IkossTest\\Mezzio\\Navigation\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Ikoss\\Mezzio\\Navigation\\ConfigProvider"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    }
}
